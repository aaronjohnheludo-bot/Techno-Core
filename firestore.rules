rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /customerReviews/{reviewId} {
      allow read, write: if true;
    }
    match /retailProducts/{productId} {
      allow read, write: if true;
    }
    match /rentalServices/{serviceId} {
      allow read, write: if true;
    }
    match /eventPackages/{packageId} {
      allow read, write: if true;
    }
    match /gallery/{galleryId} {
      allow read, write: if true;
    }
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
    match /technocore_state/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

